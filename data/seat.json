6DCBE0.jpg"],["Seat_Altea/IMG_9459D6-0C0758-AF6DF2-433101-ADF987-16EF4C.jpg"],["Seat_Altea/IMG_191EDF-7A291C-09CB88-625574-962B4D-C78E99.jpg"]],"N17":[["Seat_Altea/IMG_9DE1CB-4A30C0-64955A-9E97E9-4079EF-8BBBB1.jpg","Upoštevajte besedilo na vrhu"],["Seat_Altea/IMG_D51348-09BC3F-692C67-8BEE44-9B2508-486E8E.jpg","Upoštevajte besedilo na vrhu"],["Seat_Altea/IMG_4D0D48-AC9EF6-4062E5-5479BD-DCC6D7-5B57F6.jpg","Upoštevajte besedilo na vrhu"]],"N18":[["Seat_Altea/IMG_8C0D8A-80D3AB-3A6ADC-FA4CF2-F01E14-B10B40.jpg"],["Seat_Altea/IMG_75F033-F74F35-3C7C61-342FEF-2E75CA-39C2BB.jpg"],["Seat_Altea/IMG_874941-23A0DE-DFF567-B2940E-FC8D45-8B4F18.jpg"]],"N19":[["Seat_Altea/IMG_9ECD29-4F74B2-55B5CB-DD4BB0-664329-39F5AC.jpg"],["Seat_Altea/IMG_AC6D2E-155453-F32CED-F6A2DF-EAA4AE-C718A4.jpg"],["Seat_Altea/IMG_0208FE-36A316-0FBF6E-0AAC0D-2DCF61-0DB66A.jpg"]]}},"Seat/Altea_XL/Altea_XL":{"s":[["",[["N32","ok","Odlično ustreza – pri rahlo naprej pomaknjeni zadnji klopi se 92 cm globine optimalno izkoristi; v prtljažniku ostane še nekaj manj kot polovica površine prosta. Dovolj prostora za psico bouvier des Flandres (plečna višina 65 cm, 30 kg). Druge N32 zaradi širine nakladalnega roba ni mogoče postaviti zraven."],["N1 N4 N5 N7 N8 N9 N10 N12 N21 N22 N23 N24 N25 N29 N40 N41 N45","ok",""],["N2 N3 N42 N43","no","Preširoke (več kot 91 cm) – ne ustrezajo."]]]],"w":["Kletke, širše od 91 cm, ne ustrezajo. Pri nekaterih kletkah brez vstopnega roba je treba kletko dvigniti – priporočamo penasto ploščo (npr. stirodur)."],"p":{"N1":[["Seat_Altea_XL/IMG_788C62-CDD4AB-FFC588-6DE5C7-03D6E6-6C2E81.jpg"],["Seat_Altea_XL/IMG_B548A0-3C4AE4-1098DB-E82161-53FEF3-9D7ABF.jpg"],["Seat_Altea_XL/IMG_C334CA-405541-81EAE4-782FD6-5A4287-9DA63E.jpg"]],"N9":[["Seat_Altea_XL/IMG_EB83F5-681D2F-E6B3E2-79EB7C-DC736F-752CD8.jpg"]],"N10":[["Seat_Altea_XL/IMG_78EA86-87F768-00E2E1-4F7415-D49E91-CD8552.jpg"],["Seat_Altea_XL/IMG_107997-C9A504-FC126A-859F39-2C0486-23FB72.jpg"],["Seat_Altea_XL/IMG_A7A20A-8ED539-0A2D6D-63E2C0-70CE9B-192A76.jpg"]],"N12":[["Seat_Altea_XL/IMG_69AA12-7CB0FB-CE56A5-2E6C0E-BFFFC5-221968.jpg"]],"N32":[["Seat_Altea_XL/IMG_BC8C61-7200F7-B1D4FA-359109-7F6167-648356.jpg","N32 se v Altea XL odlično prilega – pri rahlo naprej pomaknjeni zadnji klopi se 92 cm globine optimalno izkoristi, v prtljažniku ostane še nekaj manj kot polovica površine. Dovolj prostora za psico bouvier des Flandres (plečna višina 65 cm, 30 kg). Druge N32 zaradi širine nakladalnega roba ni mogoče postaviti zraven. Ustreza tudi N1; N2 in N3 sta s širino 97 cm preširoki."],["Seat_Altea_XL/IMG_3CC9FB-9DD200-AFF586-7DD15F-F3382F-A80ED9.jpg"]],"N45":[["Seat_Altea_XL/IMG_199CCA-98FCA8-F9D0DE-02909A-398C11-A136BD.jpg"],["Seat_Altea_XL/IMG_2F73CC-6447D1-D6C7EE-F3DE8B-8D3413-F5918B.jpg"],["Seat_Altea_XL/IMG_FAC395-962766-F5BE74-849991-894987-62FA4F.jpg"]]}},"Seat/Ateca/Ateca":{"s":[["Z dvignjenim dnom (brez nakladalnega roba)",[["N11","ok","Največja enojna kletka."],["N16","small","Največja dvojna kletka – primerna le za dva majhna psa."],["N15 N17 N18 N19 N20 N36","ok",""],["N87","ok","Odlično se prilega. Visoka le 60 cm (za ne previsoke pse), zaradi navpičnih stranic pa zgoraj in spodaj široka 88 cm – optimalna za kompaktne srednje velike pse s kratkimi nogami. Pogled v vzvratno ogledalo ni oviran, ker kletka sega le do vzglavnikov."],["N46 N25","no","Ne ustrezata – kletke, globlje od 75 cm (in N46), ne ustrezajo."]]],["Brez dvignjenega dna (visok nakladalni rob, globok prtljažnik)",[["N11 N15","adapt","Ustrezata brez kakršnega koli premikanja zadnjih sedežev (naslonjalo in sedež povsem zadaj). Pod kletko podložite ~10 cm visok podstavek, da se vrata brezhibno odpirajo."],["N16","adapt","Brez premikanja zadnjih sedežev. Pod kletko ~8 cm visok podstavek."],["N47","adapt","Brez premikanja zadnjih sedežev. Pod kletko ~8 cm visok podstavek."],["N36","ok","Dobra izbira za vozila brez dvignjenega dna; smiselna tudi pri spremenljivem dnu, če želite kletko postaviti čim nižje in ohraniti poln pogled skozi vzvratno ogledalo."],["N17","tight","Ustreza z dvignjenim dnom ali brez njega, a je zgoraj zelo koničasta – za večje pse raje N36. Prikazana le za kupce z več vozili."],["N69","ok","Dobro ustreza; globina 98 cm, lepa širina."],["N87","ok","Odlično se prilega. Visoka 60 cm in sega le do vzglavnikov, pogled v vzvratno ogledalo je komaj oviran. Za srednje velike pse z nizko postavo in kratkimi nogami."],["N18 N19 N20","ok",""]]],["Druge prikazane kletke",[["N38","shown","Prikazana v vozilu."]]]],"i":["Če imate spremenljivo dno (dva položaja), pri spuščanju plošče v spodnji položaj prepognite zadnji segment. Pod kletko podložite ~2 cm debelo penasto ploščo (stirodur), da v celoti nalega."],"p":{"N11":[["Seat_Ateca/IMG_5E9D66-42BC7F-3B2C93-953306-4007A0-13531F.jpg","Vozilo z dvignjenim dnom / brez nakladalnega roba"],["Seat_Ateca/IMG_DE33AD-6F5557-6A95D4-5CD2FE-D72D42-DA8C3E.jpg","Vozilo z dvignjenim dnom / brez nakladalnega roba"],["Seat_Ateca/IMG_051E8B-F5D714-2C01E7-804C56-2DE43D-3FD499.jpg","Vozilo z dvignjenim dnom / brez nakladalnega roba"]],"N15":[["Seat_Ateca/IMG_AE1EFD-8475F7-EF2872-86B414-033339-BC46C5.jpg","Dno zgoraj"],["Seat_Ateca/IMG_3430EB-5F68D1-94019E-6A8BBE-2D0112-C8FED6.jpg","Dno zgoraj"],["Seat_Ateca/IMG_4663A5-185AED-0BB61D-D549B0-AE3DB6-49C227.jpg","Dno zgoraj"]],"N16":[["Seat_Ateca/IMG_B647FF-271EAF-34793F-D9A320-0079E8-F1D012.jpg","Vozilo z dvignjenim dnom / brez nakladalnega roba"],["Seat_Ateca/IMG_58FF8B-5AE632-7CD5FB-801BC0-1BF108-096ECF.jpg","Vozilo z dvignjenim dnom / brez nakladalnega roba"],["Seat_Ateca/IMG_2729BD-055966-1FD551-3605A0-473A7B-5041CF.jpg","Vozilo z dvignjenim dnom / brez nakladalnega roba"]],"N17":[["Seat_Ateca/IMG_697F67-52A5A0-BB363B-679CA4-647F3D-C144A5.jpg","Dno spodaj"],["Seat_Ateca/IMG_BCEDF1-4E716E-093A4F-564E2C-30C8D8-F92EE7.jpg","Dno spodaj"],["Seat_Ateca/IMG_CA553A-59D093-0574B5-F1A185-BD316F-270BAE.jpg","Dno spodaj"]],"N18":[["Seat_Ateca/IMG_1140F3-AFE735-BF6ABD-8CDFA9-838F79-8D5738.jpg","Dno spodaj"],["Seat_Ateca/IMG_07A6FA-