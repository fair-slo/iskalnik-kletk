{"v":{"Peugeot/2008/2008":{"s":[["",[["N15","ok","Največja kletka za to vozilo."],["N11","adapt","Ustreza le z ~1 cm debelo ploščo (stirodur) pod kletko, sicer levo in desno naleže na nakladalni rob."],["N18","small","Za majhne pse (npr. jazbečarja)."],["N19 N38","ok","Za srednje velike pse (npr. beagla)."],["N58","ok","Optimalna širina, a globoka le 61 cm."]]]],"p":{"N11":[["Peugeot_2008/IMG_EBCD51-F9D60E-4429F0-7DFE48-37742E-431EDD.jpg"],["Peugeot_2008/IMG_60886D-760C8A-F06584-3507B9-DC55E0-641BC2.jpg"],["Peugeot_2008/IMG_527502-A56C94-4FF685-01D5B6-DC1D07-3D5B5E.jpg"]],"N15":[["Peugeot_2008/IMG_EB6E85-B5311D-F85787-4A1ABA-424654-DA5637.jpg"],["Peugeot_2008/IMG_6D5DD8-9998AE-94D657-424B98-70283A-4A2AB2.jpg"],["Peugeot_2008/IMG_B1B730-EFD3A5-B814EA-55F355-878A9C-6A9F23.jpg"]],"N19":[["Peugeot_2008/IMG_7731B0-FFA3BC-DB734E-1BF714-1F55FE-2934C0.jpg"],["Peugeot_2008/IMG_46C530-B4C36C-C04054-CDBBE3-FC97EA-CED826.jpg"],["Peugeot_2008/IMG_077355-EEB3A0-36F9CF-7C74B9-7F6D9E-462F29.jpg"]],"N38":[["Peugeot_2008/IMG_DC4919-C87F43-20DFF4-FEFEC7-80B91E-3538C4.jpg"],["Peugeot_2008/IMG_78CE6E-F3EAB1-F1DD21-B4D8A7-885E61-6269CF.jpg"],["Peugeot_2008/IMG_2561A1-61C7E8-6A4DAA-4F7DAA-5E07B2-DC6E9F.jpg"]],"N58":[["Peugeot_2008/IMG_6A6586-F7B89B-05C136-73A7D9-C506F9-F6C077.jpg"],["Peugeot_2008/IMG_88CFA2-9F79B6-8B4E06-00D01F-581D72-E526DD.jpg"],["Peugeot_2008/IMG_6A8BCC-6920A4-90A83C-1B8EDB-94EA88-34DDD1.jpg"]]}},"Peugeot/2008_II/2008_II":{"s":[["",[["N17","adapt","Popolnoma ustreza, če odstranite dno prtljažnika (fotografija kupca)."],["N58","adapt","Fotografije kupca. Podložite ~3 cm debelo ploščo (stirodur), da se vrata kletke odpirajo. Na 4. in 5. fotografiji je bil odstranjen eden od nosilcev – to je lahko potrebno, da gre kletka širine 95,5 cm v vozilo."]]]],"i":["Druga generacija ima s prvo le malo skupnega. Prikazano vozilo očitno nima dvignjenega dna."],"p":{"N17":[["Peugeot_2008_II/IMG_6BD352-F4CE5D-8B598F-7C7834-C790F9-B6606A.jpg"]],"N58":[["Peugeot_2008_II/IMG_317E9B-805BD5-1FF302-0F263A-26AB23-5DD27A.jpg"],["Peugeot_2008_II/IMG_576CC3-7B2F56-4CE5CD-8AEC37-560C2B-7150B6.jpg"],["Peugeot_2008_II/IMG_6F8732-AB569E-1CB066-C989F8-5354C0-2A3205.jpg"]]}},"Peugeot/Peugeot_3008/Peugeot_3008/Peugeot_3008":{"s":[["Dno v najvišjem položaju",[["N26","adapt","Edina ustrezna kletka – glede vzglavnikov dveh zadnjih sedežev glejte fotografije N26 (1–6)."]]],["Dno v srednjem položaju",[["N11","ok","Največja enojna kletka."],["N15 N18 N19 N26 N58","ok",""]]],["Dno v najnižjem položaju",[["N16","small","Največja dvojna kletka – le za dva majhna psa."],["N36 N47","ok",""],["N48","no","Preširoka."]]],["Ne ustreza",[["N35","no","Ne ustreza."]]]],"i":["Spremenljivo dno je mogoče nastaviti v 3 položaje. Največja enojna kletka je N11, največja dvojna N16 (le za dva majhna psa)."],"p":{"N11":[["Peugeot_3008/IMG_6154B2-0E387A-71A81C-883FF2-0027FD-751BA0.jpg"],["Peugeot_3008/IMG_30DA36-AD2AD0-7598D6-2C75E8-DB0719-18E5D1.jpg"],["Peugeot_3008/IMG_30C647-F424DE-6EE7CA-8E9F76-044933-7FFDBA.jpg"]],"N15":[["Peugeot_3008/IMG_A379EA-FC610A-D688C0-A52785-95D3DC-834339.jpg"],["Peugeot_3008/IMG_6AB5BB-A7CB2E-0479F2-555210-0D2A43-C25CF5.jpg"],["Peugeot_3008/IMG_131D2E-904C67-A04CDD-471525-5213DF-723FD8.jpg"]],"N16":[["Peugeot_3008/IMG_994A7E-4652E7-E513BA-0F989B-FA9826-687F98.jpg"],["Peugeot_3008/IMG_1A1DD7-177F4A-13C08D-0CCC8A-4F9297-BC686C.jpg"],["Peugeot_3008/IMG_A9EA79-38682A-827BAD-FA63FA-F92414-2CC5FE.jpg"]],"N18":[["Peugeot_3008/IMG_5EBAFD-7F7FE9-ADBD30-42AD38-5EC89A-E8D363.jpg"],["Peugeot_3008/IMG_929583-AECDB1-41DD15-7F00D6-893F75-7D9102.jpg"],["Peugeot_3008/IMG_C2873E-95EFB6-04392A-E6DB18-EEEE49-DD0310.jpg"]],"N19":[["Peugeot_3008/IMG_038EF4-A2D9C9-5050E6-013D6F-8D9718-DF2496.jpg"],["Peugeot_3008/IMG_0CFE1A-1B5E9D-392F7F-34BD41-747F95-63E5A8.jpg"],["Peugeot_3008/IMG_127E51-7266E6-9C3FF7-6503FD-3BEB4C-5306A6.jpg"]],"N26":[["Peugeot_3008/IMG_BC9B97-2666B3-D14FF3-AB9DA1-25D837-F2CC8C.jpg"],["Peugeot_3008/IMG_39F550-3DABC0-356668-7E467A-6C3AFE-7CCF3D.jpg"],["Peugeot_3008/IMG_45C8C6-B1B146-2C98E8-B90ED1-7F1ECF-7DF33B.jpg"]],"N35":[["Peugeot_3008/IMG_DAFCCE-0AA6C0-9A124D-8889AF-7A3A66-9D45EF.jpg","N35 ne ustreza"]],"N36":[["Peugeot_3008/IMG_20A120-123344-9C41EB-DAE4CC-BC198B-E3DB56.jpg"],["Peugeot_3008/IMG_E6BC3C-E9B61F-46692E-DBF688-58D215-E7B3DE.jpg"],["Peugeot_3008/IMG_FD8494-61765B-AB9C4D-2037F9-955C93-074073.jpg"]],"N47":[["Peugeot_3008/IMG_30F379-7DFC59-8D281C-961788-377A87-DB90D5.jpg"],["Peugeot_3008/IMG_C85662-FC3574-A8D56C-1BBC75-46965D-BB665E.jpg"],["Peugeot_3008/IMG_2CB826-0A428C-C1F50B-C49125-7E8AD4-75017C.jpg"]],"N58":[["Peugeot_3008/IMG_A20DC4-3F9E0B-7A7D3A-25C87F-326EFC-1B6D5A.jpg"],["Peugeot_3008/IMG_969044-695C09-A0D567-10D76D-0EC899-FF37FE.jpg"],["Peugeot_3008/IMG_F2267E-BFEE3C-A0B591-3771FB-D99F5A-307D3F.jpg"]]}},"Peugeot/Peugeot_3008/Peugeot_3008_2nd/Peugeot_3008_2nd":{"s":[["Z dvignjenim dnom (plošča zgoraj, brez nakladalnega roba)",[["N59","ok","Brez omejitev – preprosto postavite. Široka 98 cm, globoka 82 cm, a zelo koničasta (zgoraj globoka le 18,5 cm), kar velikim ali starejšim psom otežuje obračanje."],["N11","ok","Brez omejitev. Posebej visoka (68 cm) in zgoraj manj koničasta od N59, a globoka le 72 cm."],["N29","ok","Brez omejitev. Globina 85 cm, širina 88 cm – dovolj prostora za srednje velikega psa, a izrazito piramidne oblike."],["N15 N16","small","Brez omejitev – le za majhne pse."],["N21 N23 N24 N25","tight","Globina 82 cm, a zaradi močno nagnjenih naslonjal zgoraj zadenejo, spodaj pa ne pridejo dovolj globoko. V vozilu jih je treba pritrditi z napenjalnimi trakovi; priporočljivo jih je zadaj dvigniti za 1–2 cm, da se (električna) vrata prtljažnika pravilno zaprejo. Priporočamo jih le, če nujno potrebujete prostor ob kletki – za večje pse sta primernejši N29 in N59."]]],["Brez dvignjenega dna (nakladalni rob, rezervno kolo odstranjeno)",[["N11 N29","ok","Brez omejitev."],["N15 N16","small","Brez omejitev – le za majhne pse."],["N59","no","Pri spuščenem dnu (rezervno kolo odstranjeno) naleže na stranske plastične nosilce dna ob zadnjih sedežih – ne ustreza."]]],["Ne ustreza",[["N28","no","Ne ustreza."]]]],"i":["Kot največjo enojno kletko priporočamo N59. Če pes rad sedi in želite visoko kletko, je prava izbira N11."],"p":{"N11":[["Peugeot_3008_2nd/IMG_219BBE-5F98A3-A1E1B5-FE88D8-3F8954-8FB498.jpg"],["Peugeot_3008_2nd/IMG_60C946-1F0DBD-78F80C-F1483D-CB9428-A4323C.jpg"],["Peugeot_3008_2nd/IMG_F4BA2F-865F98-534514-CB5326-950086-A1B690.jpg"]],"N15":[["Peugeot_3008_2nd/IMG_C97967-72FA93-4FFABA-20CF5E-F28CFD-8364F9.jpg"],["Peugeot_3008_2nd/IMG_AD6C4A-8A9253-0FA904-43D476-2AEA20-229284.jpg"],["Peugeot_3008_2nd/IMG_6362A7-8256C0-4252D8-FC8410-62D89F-935AAB.jpg"]],"N16":[["Peugeot_3008_2nd/IMG_453F85-272AA0-B66D72-B39EE1-0F54B0-1F706D.jpg"],["Peugeot_3008_2nd/IMG_1DC3C7-E95D1D-CBC473-0E6469-8A0C61-B6A018.jpg"],["Peugeot_3008_2nd/IMG_BB1175-8E3A57-3C0C92-E01218-3E452F-EA49AB.jpg"]],"N21":[["Peugeot_3008_2nd/IMG_351681-06773D-90E60A-0ECEB6-79A07B-F80E25.jpg"],["Peugeot_3008_2nd/IMG_E612B9-9BDDD9-17CF92-639A2D-C88584-E84152.jpg"],["Peugeot_3008_2nd/IMG_4FF9CE-E507A8-A7131E-5756EC-F9E2F3-334B38.jpg"]],"N23":[["Peugeot_3008_2nd/IMG_18FA07-1088D9-7FDD8B-2AB9C9-6E7D15-21B81D.jpg"],["Peugeot_3008_2nd/IMG_8628C8-320E2F-A03283-DE850E-4DE609-6EA56D.jpg"],["Peugeot_3008_2nd/IMG_44E991-F5D78F-BB7C16-62F130-874940-174063.jpg"]],"N24":[["Peugeot_3008_2nd/IMG_107F7D-04D4B7-378DDC-4B8E3E-AFA163-081DAB.jpg"],["Peugeot_3008_2nd/IMG_2850A2-9AD390-B8939E-AEF2B7-4AC9CD-A893E0.jpg"],["Peugeot_3008_2nd/IMG_F92D54-081126-683A1C-981FB3-020C9E-1A890F.jpg"]],"N25":[["Peugeot_3008_2nd/IMG_BC7747-751B2A-A09441-9FB27C-392673-654207.jpg"],["Peugeot_3008_2nd/IMG_B088CE-3BD6F9-D68502-D39C45-F40A95-2E2E54.jpg"],["Peugeot_3008_2nd/IMG_119F79-C911D4-C46931-82E629-02652D-43856B.jpg"]],"N28":[["Peugeot_3008_2nd/IMG_966554-343856-97FA29-2A916F-C0E903-38A496.jpg"]],"N29":[["Peugeot_3008_2nd/IMG_979E74-C0DF19-53097A-D2D842-D9D321-2D1FDA.jpg"],["Peugeot_3008_2nd/IMG_FDF13D-4D8984-B76486-500A28-D649E0-7315EB.jpg"],["Peugeot_3008_2nd/IMG_F749D3-259E8A-1D6C69-60A60A-E26908-210D6C.jpg"]],"N59":[["Peugeot_3008_2nd/IMG_33BF5B-136B80-635AD0-4C08A9-EBB47E-5BBF98.jpg"],["Peugeot_3008_2nd/IMG_1CD6D9-C62931-94B405-DD3725-9A6B29-4BB957.jpg"],["Peugeot_3008_2nd/IMG_B40302-6DE4FF-53FF25-45CD1A-CFCA75-8EFCC4.jpg"]]},"x":[["Peugeot_3008_2nd/IMG_28C4BC-6C77D5-502418-B15139-D018B4-89B1BB.jpg","Dno zgoraj","Prtljažnik"],["Peugeot_3008_2nd/IMG_8CD95A-DDD14A-85CFAE-074DF7-9DCB86-611BF7.jpg","Dno v spodnjem položaju","Prtljažnik"],["Peugeot_3008_2nd/IMG_0CF6F7-992A06-87A1ED-4A184C-0D3847-1C3150.jpg","Rezervno kolo je treba odstraniti"]]},"Peugeot/Rifter_L1/Rifter_L1":{"s":[["",[["N79","adapt","Dvojna, globina 90 cm, višina 75 cm – zadnjih sedežev ni mogoče premikati, kletka se kljub temu optimalno prilega, sedeži ostanejo v celoti uporabni."],["N61 N62","adapt","Enojni, globina 90 cm, višina 85 cm."]]]],"w":["Na koncu dna prtljažnika je ~3–4 cm visoka plastična poševnina, ki preprečuje, da bi kletko potisnili do konca (sicer ne naleže ravno). Podložite ~3–4 cm debelo ploščo iz stirodura (na voljo v trgovinah z gradbenim materialom, ne drobi se, enostavno jo razrežete z olfa nožem); pravo debelino določite sami."],"i":["Enak kot Citroën Berlingo III, Opel Combo E Life in Toyota ProAce City. Če ima vaše vozilo ločeno odpirajoče se zadnje steklo, nekatere kletke ne ustrezajo – glejte izvedbo eRifter L1."],"p":{"N61":[["Peugeot_Rifter_L1/IMG_E5B4DB-7A520F-29CD1B-B7BB2E-693538-8EB460.jpg"],["Peugeot_Rifter_L1/IMG_22ABCD-EE14D2-1B2234-EB85EE-CEFE39-8BE194.jpg"],["Peugeot_Rifter_L1/IMG_7AAD1A-4C587F-FD77A9-34B771-6554FB-4E929D.jpg"]],"N62":[["Peugeot_Rifter_L1/IMG_FD032C-8A782C-37D207-DF52E5-F80A5A-92053A.jpg"],["Peugeot_Rifter_L1/IMG_55C5B4-B844CC-60F5DA-10CC4C-53AECC-53F346.jpg"],["Peugeot_Rifter_L1/IMG_F30D57-804B42-86164C-6A2BBA-88BD2C-69BD75.jpg"]],"N79":[["Peugeot_Rifter_L1/IMG_899626-394036-4B999E-6C7AF1-4518BE-54441D.jpg"],["Peugeot_Rifter_L1/IMG_6512F1-BA590C-360F25-943BE2-129E1F-9FAF67.jpg"],["Peugeot_Rifter_L1/IMG_AED909-6C3C7A-7508BD-4A305B-FF9241-D0CE51.jpg"]]},"x":[["Peugeot_Rifter_L1/IMG_5D3789-7A30B1-BBE76B-AFDEAD-5426CC-2A56D7.jpg","Prazen prtljažnik","Plastična poševnina (~3–4 cm) na koncu dna preprečuje, da bi kletko potisnili do konca – sicer ne naleže ravno. Podložite ~3–4 cm debelo ploščo iz stirodura (trgovine z gradbenim materialom, poceni, ne drobi se, enostavno jo razrežete z olfa nožem)."]]},"Peugeot/eRifter_L1/eRifter_L1":{"s":[["",[["N79","ok","Največja dvojna kletka – ustreza v vsakem primeru, ne zadene blažilnikov."],["N6","ok","Po naši oceni najprimernejša enojna kletka: visoka 86 cm, notranja površina 0,74 m² – za večje pse."],["N71 N72 N73 N74 N75 N76","ok","Ustrezajo tudi v zelo veliko karavanov – zanimive, če imate še eno vozilo."],["N32","check","Za srednje velike pse; navpični stranici omogočata, da jo potisnete povsem do kolesnega loka. Notranje mere so 3 cm manjše od zunanjih (89 × 47 × 93,5 cm) – preverite, ali se pes pri širini 47 cm lahko obrne in uleže (npr. s časopisom te velikosti na tleh)."],["N30 N37 N46","shown","Prikazane v vozilu."],["N61 N62 N120","no","Globina 90 cm, višina 85 cm – zadenejo blažilnika, vrata se ne zaprejo; brez predelave (skrajšanja) niso uporabne."],["N80","no","Zadene blažilnika – ne ustreza."]]]],"i":["Enak kot Citroën Berlingo, Opel Combo in Toyota ProAce City. Prikazano vozilo ima ločeno odpirajoče se zadnje steklo z dvema blažilnikoma (glej fotografijo), ki pri nekaterih kletkah preprečita zapiranje vrat na zadnjih centimetrih."],"p":{"N6":[["Peugeot_eRifter_L1/IMG_8C1BE2-12DCCA-043BC1-B516ED-3E10D8-BA423E.jpg"],["Peugeot_eRifter_L1/IMG_A7260B-EA2741-E91483-8E700E-0E0E86-BD7536.jpg"],["Peugeot_eRifter_L1/IMG_916F15-F426D9-67C2C2-E7992D-1414C8-F98D20.jpg"]],"N30":[["Peugeot_eRifter_L1/IMG_6701E2-B34071-2030A1-E44B19-215AE7-6EE309.jpg"],["Peugeot_eRifter_L1/IMG_8D7B3C-7BC7A4-0F4392-A6A295-6555BB-72FA79.jpg"],["Peugeot_eRifter_L1/IMG_45045E-ECAE96-AE7B52-787E9E-1DE10D-44F321.jpg"]],"N32":[[